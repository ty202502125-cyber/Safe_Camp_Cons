# Copy to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000
# Set to 0.0.0.0 when deploying behind a load balancer / reverse proxy.
HOST=127.0.0.1
# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 behind one trusted reverse proxy (needed for correct client IPs in rate limits).
TRUST_PROXY=
# Use "none" with secure: true only when the UI and API are on different sites.
COOKIE_SAME_SITE=strict
# Required in production. Use a long random value (e.g. openssl rand -hex 32).
JWT_SECRET=replace-with-a-long-random-secret

# Database (use either DATABASE_URL or the individual DB_* values)
DATABASE_URL=
DB_SSL=false
# Path to a private CA certificate file when the provider uses one.
DB_CA_CERT=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Campus_connect_db
DB_USER="postgres"
DB_PASSWORD="050923"

# Initial Super Admin (only used when the portal_users table is empty).
# Required before the first start; use a long unique password.
SUPER_ADMIN_EMAIL=superadmin@wmsu.edu.ph
SUPER_ADMIN_PASSWORD=

# Password reset email. Leave blank for local testing: the API prints the
# 6-digit code in its terminal instead. Production requires real SMTP values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER= ty202502125@wmsu.edu.ph
SMTP_APP_PASSWORD=Temp2020.
SMTP_FROM=Campus Connect <ty202502125@wmsu.edu.ph>


